find_path(COMANCHECD_OPENXR_INCLUDE_DIR NAMES openxr/openxr.h)
if(NOT COMANCHECD_OPENXR_INCLUDE_DIR)
    message(FATAL_ERROR "Set COMANCHECD_OPENXR_INCLUDE_DIR to the OpenXR SDK include directory")
endif()
add_library(comanchecd_openxr host/openxr_runtime.cpp)
target_include_directories(comanchecd_openxr PUBLIC host)
target_include_directories(comanchecd_openxr SYSTEM PUBLIC "${COMANCHECD_OPENXR_INCLUDE_DIR}")
target_link_libraries(comanchecd_openxr PRIVATE ${COMANCHECD_SDL2_TARGET})
target_link_libraries(comanche_viewer PRIVATE comanchecd_openxr)
target_compile_definitions(comanche_viewer PRIVATE COMANCHECD_OPENXR_RUNTIME)
if(BUILD_TESTING)
    add_executable(openxr_runtime_tests tests/openxr_runtime_tests.cpp)
    target_link_libraries(openxr_runtime_tests PRIVATE comanchecd_openxr)
    add_test(NAME openxr_runtime_tests COMMAND openxr_runtime_tests)
endif()
