find_package(SDL2 2.0.10 CONFIG QUIET)
if(TARGET SDL2::SDL2)
    set(COMANCHECD_SDL2_TARGET SDL2::SDL2)
else()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(SDL2 REQUIRED IMPORTED_TARGET "sdl2>=2.0.10")
    set(COMANCHECD_SDL2_TARGET PkgConfig::SDL2)
endif()
add_library(comanchecd_sdl2 host/sdl_audio.cpp host/sdl_host.cpp host/sdl_controller.cpp)
target_include_directories(comanchecd_sdl2 PUBLIC host)
target_link_libraries(comanchecd_sdl2 PUBLIC comanchecd_renderer PRIVATE ${COMANCHECD_SDL2_TARGET})
add_library(comanchecd_viewer host/viewer.cpp)
target_include_directories(comanchecd_viewer PUBLIC host)
target_link_libraries(comanchecd_viewer PUBLIC comanchecd_renderer)
if(BUILD_TESTING)
    add_executable(viewer_tests tests/viewer_tests.cpp)
    target_link_libraries(viewer_tests PRIVATE comanchecd_viewer)
endif()
add_executable(training_viewer host/main.cpp)
target_link_libraries(training_viewer PRIVATE comanchecd_viewer comanchecd_sdl2)
add_executable(comanche_viewer host/session_main.cpp)
target_link_libraries(comanche_viewer PRIVATE comanchecd_viewer comanchecd_sdl2)
if(COMANCHECD_BUILD_OPENXR)
    include(cmake/OpenXr.cmake)
endif()
if(BUILD_TESTING)
    add_executable(sdl_keyboard_route tests/sdl_keyboard_route.cpp)
    target_link_libraries(sdl_keyboard_route PRIVATE comanchecd_viewer comanchecd_sdl2 ${COMANCHECD_SDL2_TARGET})
endif()
if(MINGW)
    target_link_options(comanche_viewer PRIVATE -static)
endif()
install(TARGETS comanche_viewer RUNTIME DESTINATION .)
install(FILES PREVIEW.md DESTINATION . RENAME README.md)
install(FILES LICENSE-MIT DESTINATION .)
install(FILES third_party/dbopl/COPYING third_party/SDL2-LICENSE.txt DESTINATION .)
install(DIRECTORY include src host tests third_party cmake DESTINATION source)
install(FILES CMakeLists.txt PREVIEW.md THIRD_PARTY.md LICENSE-MIT DESTINATION source)
if(WIN32 AND TARGET SDL2::SDL2)
    install(FILES $<TARGET_FILE:SDL2::SDL2> DESTINATION .)
endif()
if(TARGET audio_probe)
    target_compile_definitions(audio_probe PRIVATE COMANCHECD_SDL2_AUDIO)
    target_link_libraries(audio_probe PRIVATE comanchecd_sdl2)
endif()
if(BUILD_TESTING)
    add_executable(sdl_host_tests tests/sdl_host_tests.cpp)
    target_link_libraries(sdl_host_tests PRIVATE comanchecd_sdl2 ${COMANCHECD_SDL2_TARGET})
    add_test(NAME sdl_host_tests COMMAND sdl_host_tests)
    set_tests_properties(sdl_host_tests PROPERTIES ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;SDL_RENDER_DRIVER=software")
    add_executable(sdl_controller_tests tests/sdl_controller_tests.cpp)
    target_link_libraries(sdl_controller_tests PRIVATE comanchecd_sdl2 ${COMANCHECD_SDL2_TARGET})
    add_test(NAME sdl_controller_tests COMMAND sdl_controller_tests)
    set_tests_properties(sdl_controller_tests PROPERTIES SKIP_RETURN_CODE 77
        ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;SDL_RENDER_DRIVER=software")
endif()
if(WIN32 AND TARGET SDL2::SDL2)
    foreach(target training_viewer comanche_viewer audio_probe sdl_host_tests sdl_controller_tests sdl_keyboard_route openxr_runtime_tests)
        if(TARGET ${target})
            add_custom_command(TARGET ${target} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:SDL2::SDL2> $<TARGET_FILE_DIR:${target}>)
        endif()
    endforeach()
endif()
